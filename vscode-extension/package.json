{
  "name": "beautify-json-log-vscode",
  "displayName": "Beautify JSON Log",
  "description": "Preview selected JSON (or JSON embedded in logs and string literals) with syntax highlighting in a split panel. Works in VS Code and Cursor.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "codewaveds",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mateus8741/beautifyJsonLog.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/Mateus8741/beautifyJsonLog/tree/main/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/Mateus8741/beautifyJsonLog/issues"
  },
  "keywords": [
    "json",
    "log",
    "pretty",
    "viewer",
    "cursor"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "beautify-json-log.preview",
        "title": "Preview Selection",
        "category": "Beautify JSON Log"
      }
    ],
    "keybindings": [
      {
        "command": "beautify-json-log.preview",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "beautify-json-log.preview",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies",
    "publish:vscode": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ovsx": "^1.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^@codewaveds/beautify-json-log/react$": "<rootDir>/../src/react/index.ts",
      "^react-dom$": "<rootDir>/node_modules/react-dom",
      "^react-dom/(.*)$": "<rootDir>/node_modules/react-dom/$1",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1"
    }
  }
}
