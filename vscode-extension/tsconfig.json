{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node", "jest", "vscode"],
    "paths": {
      "@codewaveds/beautify-json-log/*": ["../src/*"],
      "@codewaveds/beautify-json-log": ["../src/index.ts"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-dom/*": ["node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
